<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Include ProteomIQon source files directly -->
    <Compile Include="..\..\src\ProteomIQon\Ontologies.fs" />
    <Compile Include="..\..\src\ProteomIQon\DeedleExtensionsTemp.fs" />
    <Compile Include="..\..\src\ProteomIQon\BioFSharp.Mz_Temp.fs" />
    <Compile Include="..\..\src\ProteomIQon\pepValueCalculation.fs" />
    <Compile Include="..\..\src\ProteomIQon\Logging.fs" />
    <Compile Include="..\..\src\ProteomIQon\Domain.fs" />
    <Compile Include="..\..\src\ProteomIQon\DTO.fs" />
    <Compile Include="..\..\src\ProteomIQon\Json.fs" />
    <Compile Include="..\..\src\ProteomIQon\Core.fs" />
    
    <!-- Test files last -->
    <Compile Include="Tests.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expecto test packages -->
    <PackageReference Include="Expecto" Version="10.*" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Update="FSharp.Core" Version="8.*" />
    
    <!-- Dependencies from ProteomIQon.fsproj -->
    <PackageReference Include="Argu" Version="6.1.1" />
    <PackageReference Include="NLog" Version="4.7.11" />
    <PackageReference Include="MzIO" Version="0.1.7" />
    <PackageReference Include="MzIO.Processing" Version="0.1.7" />
    <PackageReference Include="MzIO.SQL" Version="0.1.9" />
    <PackageReference Include="MzIO.MzML" Version="0.1.10" />
    <PackageReference Include="Deedle" Version="2.3.0" />
    <PackageReference Include="BioFSharp" Version="2.0.0-beta4" />
    <PackageReference Include="BioFSharp.IO" Version="2.0.0-beta4" />
    <PackageReference Include="BioFSharp.Mz" Version="0.1.5-beta" />
    <PackageReference Include="FSharpAux" Version="1.0.0" />
    <PackageReference Include="FSharpAux.IO" Version="1.0.0" />
    <PackageReference Include="FSharp.Stats" Version="0.4.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="DynamicObj" Version="2.0.0" />
    <PackageReference Include="Plotly.NET" Version="2.0.0" />
  </ItemGroup>
</Project>
